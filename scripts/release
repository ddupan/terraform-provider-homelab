#!/usr/bin/env bash
# Second half of a release (release.yml `release`, on the homelab ARC runner, which reaches the LAN-only
# registry and bucket): upload what scripts/build-release built to the registry bucket. Nothing is
# published yet: terraform only finds a version through the versions index and the per-platform
# download documents, which scripts/publish writes on the maintainer's machine after verifying and
# signing SHA256SUMS with the maintainer's own key (YubiKey). The workflow logs in to OpenBao as
# spiffe://ddupan.top/ci/github/ddupan/terraform-provider-homelab/release (BAO_ADDR/BAO_TOKEN in env,
# revoked by the login action's post step); the S3 keys never reach argv or the log.
set -euo pipefail

version=${1:?usage: scripts/release <version> <dir>}
dist=${2:?usage: scripts/release <version> <dir>}
: "${BAO_ADDR:?}" "${BAO_TOKEN:?}"
namespace=ddupan type=homelab
registry=https://terraform.lab.ddupan.top
s3=${S3_ENDPOINT:-https://s3.lab.ddupan.top}/terraform-registry

# A published version is immutable: its SHA256SUMS carries the maintainer's signature, and a rebuilt
# zip (new timestamps, new hash) would make it uninstallable.
# Only a 404 means "not published": an unreachable registry must not be mistaken for it.
status=$(curl -sS -o /dev/null -w '%{http_code}' "$registry/v1/providers/$namespace/$type/$version/download/linux/amd64")
case $status in
  404) ;;
  200) echo "$namespace/$type $version is already published; tag a new version instead" >&2; exit 1 ;;
  *) echo "cannot check whether $version is published (HTTP $status)" >&2; exit 1 ;;
esac

umask 077
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
printf 'X-Vault-Token: %s\n' "$BAO_TOKEN" > "$work/bao-header"
curl -fsS -H @"$work/bao-header" "$BAO_ADDR/v1/kv/data/k8s/terraform-registry-s3-publisher" > "$work/s3.json"
printf 'user = "%s:%s"\n' "$(jq -er .data.data.access_key "$work/s3.json")" "$(jq -er .data.data.secret_key "$work/s3.json")" > "$work/s3.curlrc"

put() { # put <local file> <key> <content type>
  curl -fsS -o /dev/null -K "$work/s3.curlrc" --aws-sigv4 "aws:amz:us-east-1:s3" \
    -H "Content-Type: $3" -T "$1" "$s3/$2"
}

files=providers/$namespace/$type/$version
for file in "$dist"/*; do put "$file" "$files/$(basename "$file")" application/octet-stream; done

echo "Uploaded $namespace/$type $version; publish with: scripts/publish $version"
