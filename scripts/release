#!/usr/bin/env bash
# CI half of a release (job `release`, on a v* tag): build the zips and SHA256SUMS and upload them to
# the registry bucket. Nothing is published yet: terraform only finds a version through the versions
# index and the per-platform download documents, which scripts/publish writes on the maintainer's
# machine after verifying and signing SHA256SUMS with the maintainer's own key (YubiKey). Upload
# credentials come from OpenBao through the job's SPIFFE identity
# (spiffe://ddupan.top/ci/panxiao81/terraform-provider-homelab/release), never via argv or the log.
set -euo pipefail

version=${1:?usage: scripts/release <version>}
namespace=ddupan type=homelab
registry=https://terraform.lab.ddupan.top
s3=${S3_ENDPOINT:-http://seaweedfs-s3.seaweedfs.svc.cluster.local:8333}/terraform-registry
bao=${BAO_ADDR:-https://bao.ad.ddupan.top:8200}
socket=${SPIFFE_SOCKET:-/run/spire/agent-sockets/spire-agent.sock}
platforms=(linux/amd64 linux/arm64)

# A published version is immutable: its SHA256SUMS carries the maintainer's signature, and a rebuilt
# zip (new timestamps, new hash) would make it uninstallable.
if curl -fsS -o /dev/null "$registry/v1/providers/$namespace/$type/$version/download/linux/amd64" 2>/dev/null; then
  echo "$namespace/$type $version is already published; tag a new version instead" >&2
  exit 1
fi

umask 077
work=$(mktemp -d)
token=
cleanup() {
  [[ -n $token ]] && curl -fsS -o /dev/null -X POST -H @"$work/bao-header" "$bao/v1/auth/token/revoke-self" || true
  rm -rf -- "$work"
}
trap cleanup EXIT

# Build: one zip per platform, the binary named as Terraform expects.
dist=$work/dist
mkdir -p "$dist"
for platform in "${platforms[@]}"; do
  os=${platform%/*} arch=${platform#*/}
  binary=terraform-provider-${type}_v${version}
  CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags "-s -w -X main.version=$version" -o "$work/$binary" .
  (cd "$work" && zip -q -X "$dist/terraform-provider-${type}_${version}_${os}_${arch}.zip" "$binary" && rm "$binary")
done
sums=terraform-provider-${type}_${version}_SHA256SUMS
(cd "$dist" && sha256sum -- *.zip > "$sums")

# OpenBao login with the job's JWT-SVID; the token stays in a header file.
spire-agent api fetch jwt -audience openbao -socketPath "$socket" -output json > "$work/svid.json"
jq -er '[.. | objects | .svid? // empty] | if length == 1 then .[0] else error("expected one JWT-SVID") end' "$work/svid.json" > "$work/jwt"
token=$(jq -n --arg role ci-terraform-registry-publisher --rawfile jwt "$work/jwt" '{role: $role, jwt: ($jwt | rtrimstr("\n"))}' \
  | curl -fsS -X POST --data @- "$bao/v1/auth/jwt-spire/login" | jq -er .auth.client_token)
printf 'X-Vault-Token: %s\n' "$token" > "$work/bao-header"
curl -fsS -H @"$work/bao-header" "$bao/v1/kv/data/k8s/terraform-registry-s3-publisher" > "$work/s3.json"
printf 'user = "%s:%s"\n' "$(jq -er .data.data.access_key "$work/s3.json")" "$(jq -er .data.data.secret_key "$work/s3.json")" > "$work/s3.curlrc"

put() { # put <local file> <key> <content type>
  curl -fsS -o /dev/null -K "$work/s3.curlrc" --aws-sigv4 "aws:amz:us-east-1:s3" \
    -H "Content-Type: $3" -T "$1" "$s3/$2"
}

files=providers/$namespace/$type/$version
for file in "$dist"/*; do put "$file" "$files/$(basename "$file")" application/octet-stream; done

echo "Uploaded $namespace/$type $version; publish with: scripts/publish $version"
